# ⛔ EXAMPLE ONLY. Copy to .env (gitignored). Never paste a real secret into chat or a commit.

# ── Databricks Unity Catalog ─────────────────────────────────────────────────────────────────
# Workspace host. This is the Panthers Azure Databricks workspace (o=7405617646104787).
DATABRICKS_HOST=https://adb-7405617646104787.7.azuredatabricks.net
# Leave the token EMPTY on a laptop: `databricks auth login --host <host>` (Databricks CLI) or `az login`
# (Azure CLI) is enough; the client fetches a fresh token on every call. A PAT is for headless machines.
DATABRICKS_TOKEN=
# SQL warehouse HTTP path (SQL Warehouses → your warehouse → Connection details → HTTP path).
# Required for SQL reads. Looks like /sql/1.0/warehouses/0123456789abcdef
DATABRICKS_HTTP_PATH=
# Optional: a profile name from ~/.databrickscfg instead of the two values above.
DATABRICKS_CONFIG_PROFILE=
# Or an Azure service principal added to the workspace (headless / CI). Pure HTTPS to login.microsoftonline.com.
ARM_TENANT_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=

# ── Unity Catalog names ──────────────────────────────────────────────────────────────────────
# PFF bronze tables are pff.bronze.<table> (pffplays, pffdefense, coverage_defense, ...).
# Override any one here if the workspace differs; `poshub discover` verifies live.
POSHUB_TABLE_PFFPLAYS=
POSHUB_TABLE_PFFDEFENSE=
POSHUB_TABLE_PFFOFFENSE=
POSHUB_TABLE_COVERAGE_DEFENSE=
POSHUB_TABLE_PFFROSTERS=
# NGS frame tracking, if it has been registered in Unity Catalog (unknown as of 2026-09-25 —
# run `poshub discover` to find out). Leave empty to read the per-game parquet files instead.
POSHUB_TABLE_NGS_TRACKING=
# Unity Catalog Volume where exports/outputs land
POSHUB_UC_VOLUME=/Volumes/pff/bronze/exports

# ── Local data root (fallback when Databricks is unreachable) ────────────────────────────────
# Same convention as panthers_projects: <root>/data/pff_export/<table>/*.parquet and
# <root>/<season>_NGS_Player_Play/<week>/<game_key>.parquet
PANTHERS_DATA_DIR=

# ── Thunder / XOS / Catapult film API (server-side only) ─────────────────────────────────────
THUNDER_BASE_URL=https://tclightningservices.xosdigital.com/Api
THUNDER_SSO_URL=https://tcssoservices.xosdigital.com/sso/RESTSSOServices.svc
THUNDER_USERNAME=
THUNDER_PASSWORD=
# issued by XOS/Catapult support; needed only for deep links into a coach's Thunder client
THUNDER_VENDOR_GUID=

# ── Catapult OpenField (athlete GPS / sensor telemetry) ──────────────────────────────────────
# The JWT the club holds has scopes: connect, catapultr, sensor-read-only, athletes-update, ...
# It is NOT a Thunder credential. Region host: connect-us for a backend-us issuer.
OPENFIELD_BASE_URL=https://connect-us.catapultsports.com/api/v6
OPENFIELD_TOKEN=

# ── PFF Ultimate (film deep links only; PFF has no API in this stack) ────────────────────────
PFF_ULTIMATE_BASE_URL=https://ultimate.pff.com
